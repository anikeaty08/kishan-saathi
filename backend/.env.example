# Application
APP_ENV=development
APP_NAME=Kishan Saathi API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL (local Docker value; never commit production credentials)
DATABASE_URL=postgresql+asyncpg://krishisathi:krishisathi@localhost:5432/krishisathi
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Amazon Cognito
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWKS_CACHE_SECONDS=3600
EXTERNAL_REQUEST_TIMEOUT_SECONDS=5

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5
OPENAI_LIGHT_MODEL=gpt-5-mini

# Mem0 Platform
MEM0_API_KEY=

# Local object storage used before S3 deployment
LOCAL_STORAGE_PATH=./storage
MAX_IMAGE_BYTES=10485760
MAX_DIAGNOSIS_UPLOAD_BYTES=52428800
STORED_IMAGE_MAX_DIMENSION=2048
STORED_IMAGE_JPEG_QUALITY=90
