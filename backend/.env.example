# Application
APP_ENV=development
APP_NAME=Kishan Saathi API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL (local Docker value; never commit production credentials)
DATABASE_URL=postgresql+asyncpg://krishisathi:krishisathi@localhost:5432/krishisathi
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Amazon Cognito
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWKS_CACHE_SECONDS=3600
EXTERNAL_REQUEST_TIMEOUT_SECONDS=5
OPENAI_REQUEST_TIMEOUT_SECONDS=45

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5
OPENAI_LIGHT_MODEL=gpt-5-mini

# Mem0 Platform
MEM0_API_KEY=

# Weather (one-hour DB cache; Open-Meteo requires no key for this usage)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_CACHE_SECONDS=3600
WEATHER_MAX_STALE_SECONDS=21600

# Local object storage used before S3 deployment
LOCAL_STORAGE_PATH=./storage
MAX_IMAGE_BYTES=10485760
MAX_DIAGNOSIS_UPLOAD_BYTES=52428800
MAX_DIAGNOSIS_IMAGES=12
STORED_IMAGE_MAX_DIMENSION=2048
SOURCE_IMAGE_MAX_PIXELS=25000000
STORED_IMAGE_JPEG_QUALITY=90
OBJECT_CLEANUP_INTERVAL_SECONDS=30
OBJECT_CLEANUP_BATCH_SIZE=50
OBJECT_CLEANUP_BACKOFF_BASE_SECONDS=60
OBJECT_CLEANUP_BACKOFF_MAX_SECONDS=21600
DIAGNOSIS_LOW_CONFIDENCE_THRESHOLD=0.50
DIAGNOSIS_HIGH_CONFIDENCE_THRESHOLD=0.75
