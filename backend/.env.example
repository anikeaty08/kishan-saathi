# Application
APP_ENV=development
APP_NAME=Kishan Saathi API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL (local Docker value; never commit production credentials)
DATABASE_URL=postgresql+asyncpg://krishisathi:krishisathi@localhost:5432/krishisathi
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Amazon Cognito
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWKS_CACHE_SECONDS=3600
COGNITO_JWKS_MIN_REFRESH_SECONDS=60
COGNITO_JWKS_MAX_BYTES=262144
EXTERNAL_REQUEST_TIMEOUT_SECONDS=5
OPENAI_REQUEST_TIMEOUT_SECONDS=45

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5
OPENAI_LIGHT_MODEL=gpt-5-mini
LEAF_INFERENCE_BACKEND=openai_vision
OPENAI_LEAF_MODEL=gpt-5
OPENAI_LEAF_CONFIDENCE_CAP=0.74
OPENAI_PROGRESSION_MODEL=gpt-5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=tts-1
OPENAI_SPEECH_VOICE=coral
OPENAI_AUDIO_TIMEOUT_SECONDS=45
DIAGNOSIS_REQUESTS_PER_MINUTE=6
CHAT_REQUESTS_PER_MINUTE=8
WEATHER_REQUESTS_PER_MINUTE=12
AUTH_REQUESTS_PER_MINUTE=10
AUTH_IP_REQUESTS_PER_MINUTE=120
# At least 32 random characters in production; keep in a secret manager.
AUTH_RATE_LIMIT_HMAC_KEY=
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_TRANSCRIPT_CHARACTERS=4000
VOICE_MAX_SPEECH_CHARACTERS=4096
VOICE_TRANSCRIPTIONS_PER_MINUTE=6
VOICE_SPEECH_REQUESTS_PER_MINUTE=12
PROGRESSION_REQUESTS_PER_MINUTE=4
MEMORY_CONNECTIONS_PER_MINUTE=2
PAID_PROVIDER_MAX_CONCURRENT_REQUESTS=4

# Mem0 Platform
MEM0_API_KEY=
MEMORY_CAPTURE_INTERVAL_SECONDS=30
MEMORY_CAPTURE_BATCH_SIZE=20
MEMORY_CAPTURE_MAX_ATTEMPTS=10

# Weather (one-hour DB cache; Open-Meteo requires no key for this usage)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_CACHE_SECONDS=3600
WEATHER_MAX_STALE_SECONDS=21600

# Local object storage used before S3 deployment
LOCAL_STORAGE_PATH=./storage
STORAGE_BACKEND=local
S3_BUCKET=
S3_KEY_PREFIX=private
S3_KMS_KEY_ID=
S3_EXPECTED_BUCKET_OWNER=
# Development/test only (for example LocalStack). Forbidden in production.
S3_ENDPOINT_URL=
MAX_IMAGE_BYTES=10485760
MAX_DIAGNOSIS_UPLOAD_BYTES=52428800
MAX_DIAGNOSIS_IMAGES=12
MAX_DIAGNOSIS_CASE_IMAGES=36
DIAGNOSIS_CAPTURE_FUTURE_TOLERANCE_MINUTES=10
DIAGNOSIS_CAPTURE_MAX_AGE_DAYS=3650
STORED_IMAGE_MAX_DIMENSION=2048
SOURCE_IMAGE_MAX_PIXELS=25000000
STORED_IMAGE_JPEG_QUALITY=90
OBJECT_CLEANUP_INTERVAL_SECONDS=30
OBJECT_CLEANUP_BATCH_SIZE=50
OBJECT_CLEANUP_BACKOFF_BASE_SECONDS=60
OBJECT_CLEANUP_BACKOFF_MAX_SECONDS=21600
DIAGNOSIS_LOW_CONFIDENCE_THRESHOLD=0.50
DIAGNOSIS_HIGH_CONFIDENCE_THRESHOLD=0.75
PROGRESSION_MAX_IMAGES_PER_TIMEPOINT=3
PROGRESSION_MAX_TOTAL_IMAGE_BYTES=15728640
PROGRESSION_HISTORY_SCAN_LIMIT=20
PROGRESSION_MIN_IMAGE_DIMENSION=160
PROGRESSION_MIN_IMAGE_QUALITY_SCORE=0.45
