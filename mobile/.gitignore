# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/android/.kotlin/
/coverage/
/test/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local runtime configuration. Keep credentials and machine-specific URLs out of git.
/config/*.local.json
.env

# Rejected authentication collage drafts; the app uses one continuous field hero.
/assets/images/auth_crop_flowers.webp
/assets/images/auth_crop_leaves.webp
/assets/images/auth_seedlings.webp
/assets/images/auth_seeds_soil.webp
